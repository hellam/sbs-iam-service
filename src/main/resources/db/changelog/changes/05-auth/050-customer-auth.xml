<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ============================================================= -->
    <!-- CUSTOMER AUTH                                                 -->
    <!-- Authentication for Customer Channels (IB + Mobile)            -->
    <!-- Applies to BOTH retail and corporate users                    -->
    <!-- ============================================================= -->

    <changeSet id="pg-iam-050-customer-auth" author="hellamimbosa">

        <comment>
            CUSTOMER_AUTH stores authentication data for customer channels:
            - Internet Banking credentials (password)
            - Mobile Banking credentials (PIN)
            - Customer MFA (OTP/TOTP)

            Applies to:
            - Retail Customers
            - Corporate Users (org users) who log into corporate IB

            NOT applicable to employees (BO), which use employee_auth.
        </comment>

        <createTable tableName="customer_auth">

            <!-- PK -->
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_customer_auth"/>
            </column>

            <!-- FK to IAM_USER -->
            <column name="iam_user_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- ========================= -->
            <!-- INTERNET BANKING PASSWORD -->
            <!-- ========================= -->
            <column name="internet_password_hash" type="VARCHAR(255)"/>
            <column name="internet_password_algo" type="VARCHAR(50)" defaultValue="bcrypt"/>
            <column name="internet_password_expiry" type="TIMESTAMPTZ"/>
            <column name="internet_password_changed_at" type="TIMESTAMPTZ"/>
            <column name="internet_first_time_login" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="internet_failed_attempts" type="SMALLINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="internet_locked" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="internet_last_login_at" type="TIMESTAMPTZ"/>

            <!-- ========================= -->
            <!-- MOBILE BANKING PIN        -->
            <!-- ========================= -->
            <column name="mobile_pin_hash" type="VARCHAR(255)"/>
            <column name="mobile_pin_algo" type="VARCHAR(50)" defaultValue="bcrypt"/>
            <column name="mobile_pin_set_at" type="TIMESTAMPTZ"/>
            <column name="mobile_first_time_login" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="mobile_failed_attempts" type="SMALLINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="mobile_locked" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="mobile_last_login_at" type="TIMESTAMPTZ"/>

            <!-- ========================= -->
            <!-- MFA                       -->
            <!-- ========================= -->
            <column name="mfa_enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="mfa_secret" type="VARCHAR(255)"/>
            <column name="mfa_last_verified_at" type="TIMESTAMPTZ"/>

            <!-- Audit -->
            <column name="created_at" type="TIMESTAMPTZ" defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="customer_auth" baseColumnNames="iam_user_id"
                referencedTableName="iam_user" referencedColumnNames="id"
                constraintName="fk_customer_auth_iam_user"/>

        <createIndex tableName="customer_auth" indexName="idx_customer_auth_user">
            <column name="iam_user_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
