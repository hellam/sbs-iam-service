<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ============================================================= -->
    <!-- CORPORATE APPROVAL POLICY (Maker/Checker/Signatory)           -->
    <!-- ============================================================= -->

    <changeSet id="pg-iam-074-corp-approval-policy" author="hellamimbosa">

        <createTable tableName="corporate_approval_policy" schemaName="iam_service">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_corp_approval_policy"/>
            </column>

            <column name="policy_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- Basic flow -->
            <column name="require_maker_checker" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="require_signatory_approval" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="require_checker_approval" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="allow_single_signatory" type="BOOLEAN" defaultValueBoolean="true"/>


            <!-- Approval counts -->
            <column name="min_signatories" type="SMALLINT" defaultValueNumeric="1"/>
            <column name="max_signatories" type="SMALLINT" defaultValueNumeric="3"/>


            <!-- Threshold-based approval tiers -->
            <column name="tier_one_limit" type="DECIMAL(18,2)" defaultValueNumeric="1000"/>
            <column name="tier_two_limit" type="DECIMAL(18,2)" defaultValueNumeric="10000"/>
            <column name="tier_three_limit" type="DECIMAL(18,2)" defaultValueNumeric="100000"/>

            <!-- Require MFA for high-value approvals -->
            <column name="require_mfa_above_limit" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="mfa_threshold" type="DECIMAL(18,2)" defaultValueNumeric="5000"/>

            <!-- Approver password/PIN policies -->
            <column name="require_approver_pin" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="approver_pin_min_length" type="SMALLINT" defaultValueNumeric="4"/>
            <column name="approver_pin_max_length" type="SMALLINT" defaultValueNumeric="6"/>
            <column name="approver_password_history_count" type="SMALLINT" defaultValueNumeric="5"/>

            <!-- Lockout -->
            <column name="max_failed_approvals" type="SMALLINT" defaultValueNumeric="5"/>
            <column name="approval_lockout_minutes" type="SMALLINT" defaultValueNumeric="30"/>

            <!-- Audit -->
            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <createIndex tableName="corporate_approval_policy"
                     indexName="idx_corp_approval_policy_base">
            <column name="policy_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
