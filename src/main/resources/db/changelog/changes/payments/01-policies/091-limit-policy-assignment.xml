<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="
                     http://www.liquibase.org/xml/ns/dbchangelog
                     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="pg-policy-101-limit-assignment" author="hellamimbosa">

        <createTable tableName="limit_policy_assignment">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="limit_policy_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Scope of the policy assignment: GLOBAL, ORGANIZATION, USER -->
            <column name="scope" type="VARCHAR(50)" defaultValue="GLOBAL"/>

            <column name="organization_id" type="BIGINT"/>
            <column name="iam_user_id" type="BIGINT"/>

            <!-- Allow override of limits at assignment level -->
            <column name="allow_override" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>


            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint baseTableName="limit_policy_assignment" baseColumnNames="limit_policy_id"
                                 referencedTableName="limit_policy" referencedColumnNames="id"
                                 constraintName="fk_limit_assignment_policy"/>

        <addForeignKeyConstraint baseTableName="limit_policy_assignment" baseColumnNames="organization_id"
                                 referencedTableName="party" referencedColumnNames="id"
                                 constraintName="fk_limit_assignment_org"/>

        <addForeignKeyConstraint baseTableName="limit_policy_assignment" baseColumnNames="iam_user_id"
                                 referencedTableName="iam_user" referencedColumnNames="id"
                                 constraintName="fk_limit_assignment_user"/>

    </changeSet>

</databaseChangeLog>
