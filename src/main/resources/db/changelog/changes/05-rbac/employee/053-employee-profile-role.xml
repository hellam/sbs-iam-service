<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 053 - EMPLOYEE PROFILE → ROLES -->

    <changeSet id="pg-rbac-053-employee-profile-role" author="hellamimbosa">

        <createTable tableName="employee_profile_role">

            <column name="employee_profile_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="employee_role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="assigned_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <addPrimaryKey tableName="employee_profile_role"
                       columnNames="employee_profile_id,employee_role_id"
                       constraintName="pk_employee_profile_role"/>

        <addForeignKeyConstraint
                baseTableName="employee_profile_role"
                baseColumnNames="employee_profile_id"
                referencedTableName="employee_profile"
                referencedColumnNames="id"
                constraintName="fk_emp_profile_role_profile"/>

        <addForeignKeyConstraint
                baseTableName="employee_profile_role"
                baseColumnNames="employee_role_id"
                referencedTableName="employee_role"
                referencedColumnNames="id"
                constraintName="fk_emp_profile_role_role"/>

        <createIndex tableName="employee_profile_role"
                     indexName="idx_emp_profile_role_profile">
            <column name="employee_profile_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
