<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 110 - SESSIONS -->

    <changeSet id="pg-iam-110-sessions" author="hellamimbosa">

        <createTable tableName="sessions">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_sessions"/>
            </column>

            <column name="iam_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- JWT jti or internal session ID -->
            <column name="session_id" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="channel" type="channel_enum"/>

            <column name="device_id" type="VARCHAR(255)"/>
            <column name="ip_address" type="VARCHAR(50)"/>
            <column name="user_agent" type="TEXT"/>

            <!-- ACTIVE, REVOKED, EXPIRED, etc -->
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="last_access_at" type="TIMESTAMPTZ"/>
            <column name="expires_at" type="TIMESTAMPTZ"/>
            <column name="revoked_at" type="TIMESTAMPTZ"/>
            <column name="revoked_reason" type="TEXT"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="sessions" baseColumnNames="iam_user_id"
                referencedTableName="iam_user" referencedColumnNames="id"
                constraintName="fk_sessions_user"/>

        <createIndex tableName="sessions" indexName="idx_sessions_user">
            <column name="iam_user_id"/>
        </createIndex>

        <createIndex tableName="sessions" indexName="idx_sessions_status">
            <column name="status"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
