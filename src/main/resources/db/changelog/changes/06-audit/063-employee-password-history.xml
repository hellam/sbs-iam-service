<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ============================================================= -->
    <!-- EMPLOYEE PASSWORD HISTORY                                     -->
    <!-- ============================================================= -->

    <changeSet id="pg-iam-063-employee-password-history" author="hellamimbosa">

        <createTable tableName="employee_password_history">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_employee_pwd_history"/>
            </column>

            <column name="iam_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="password_algo" type="VARCHAR(50)" defaultValue="bcrypt"/>

            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="employee_password_history" baseColumnNames="iam_user_id"
                referencedTableName="iam_user" referencedColumnNames="id"
                constraintName="fk_emp_pwd_hist_user"/>

        <createIndex tableName="employee_password_history" indexName="idx_emp_pwd_hist_user">
            <column name="iam_user_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
