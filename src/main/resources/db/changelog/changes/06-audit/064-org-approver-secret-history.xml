<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ============================================================= -->
    <!-- ORG USER APPROVER SECRET HISTORY                              -->
    <!-- (Approval PIN / Approval Password)                            -->
    <!-- ============================================================= -->

    <changeSet id="pg-iam-064-org-approver-secret-history" author="hellamimbosa">

        <createTable tableName="organization_approver_secret_history">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_org_approver_secret_history"/>
            </column>

            <column name="organization_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Old approval secret -->
            <column name="approver_password_hash" type="VARCHAR(255)"/>
            <column name="approver_pin_hash" type="VARCHAR(255)"/>

            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="organization_approver_secret_history"
                baseColumnNames="organization_user_id"
                referencedTableName="organization_user" referencedColumnNames="id"
                constraintName="fk_org_approver_secret_user"/>

        <createIndex tableName="organization_approver_secret_history"
                     indexName="idx_org_approver_secret_user">
            <column name="organization_user_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
