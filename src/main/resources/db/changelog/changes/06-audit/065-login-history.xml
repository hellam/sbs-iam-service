<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 130 - LOGIN HISTORY -->

    <changeSet id="pg-iam-065-login-history" author="hellamimbosa">

        <createTable tableName="login_history">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_login_history"/>
            </column>

            <!-- May be null if login failed before user resolved -->
            <column name="iam_user_id" type="BIGINT"/>

            <column name="channel" type="channel_enum"/>
            <column name="identifier_used" type="VARCHAR(255)"/>

            <column name="success" type="BOOLEAN" defaultValueBoolean="false"/>
            <!-- e.g. INVALID_PASSWORD, ACCOUNT_LOCKED, MFA_FAILED -->
            <column name="failure_reason" type="VARCHAR(100)"/>

            <column name="ip_address" type="VARCHAR(50)"/>
            <column name="device_id" type="VARCHAR(255)"/>
            <column name="user_agent" type="TEXT"/>

            <column name="location_country" type="VARCHAR(2)"/>
            <column name="location_city" type="VARCHAR(100)"/>

            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="login_history" baseColumnNames="iam_user_id"
                referencedTableName="iam_user" referencedColumnNames="id"
                constraintName="fk_login_history_user"/>

        <createIndex tableName="login_history" indexName="idx_login_history_user">
            <column name="iam_user_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
