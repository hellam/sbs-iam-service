<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="pg-iam-053-iam-user-security-question" author="hellamimbosa">

        <createTable tableName="iam_user_security_question">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_iam_user_security_question"/>
            </column>

            <column name="iam_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="security_question_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Hashed answer (bcrypt/argon2) -->
            <column name="answer_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="answer_algo" type="VARCHAR(50)" defaultValue="bcrypt"/>

            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>

            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="iam_user_security_question"
                baseColumnNames="iam_user_id"
                referencedTableName="iam_user"
                referencedColumnNames="id"
                constraintName="fk_user_secq_user"/>

        <addForeignKeyConstraint
                baseTableName="iam_user_security_question"
                baseColumnNames="security_question_id"
                referencedTableName="security_question"
                referencedColumnNames="id"
                constraintName="fk_user_secq_question"/>

        <createIndex tableName="iam_user_security_question"
                     indexName="idx_user_secq_user">
            <column name="iam_user_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
