<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="
                     http://www.liquibase.org/xml/ns/dbchangelog
                     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="pg-policy-081-feature-policy" author="hellamimbosa">

        <createTable tableName="feature_policy" schemaName="iam_service">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="feature_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- ALLOW / BLOCK -->
            <column name="enabled" type="BOOLEAN" defaultValue="true">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="feature_policy" baseColumnNames="feature_id"
                                 referencedTableName="features" referencedColumnNames="id"
                                 constraintName="fk_feature_policy_feature"/>

    </changeSet>

</databaseChangeLog>
