<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ============================================================= -->
    <!-- MFA POLICY (IB, MB, BACKOFFICE)                               -->
    <!-- ============================================================= -->

    <changeSet id="pg-iam-073-mfa-policy" author="hellamimbosa">

        <createTable tableName="mfa_policy" schemaName="iam_service">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_mfa_policy"/>
            </column>

            <column name="policy_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- Channel activation -->
            <column name="require_mfa_ib" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="require_mfa_mb" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="require_mfa_backoffice" type="BOOLEAN" defaultValueBoolean="true"/>

            <!-- Allowed MFA types -->
            <column name="allow_totp" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="allow_sms_otp" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="allow_email_otp" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="allow_whatsapp_otp" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="allow_push" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="allow_webauthn" type="BOOLEAN" defaultValueBoolean="false"/>

            <!-- OTP settings -->
            <column name="otp_expiry_seconds" type="INTEGER" defaultValueNumeric="120"/>
            <column name="otp_daily_limit" type="SMALLINT" defaultValueNumeric="10"/>

            <!-- Transaction-level MFA -->
            <column name="require_mfa_high_value_txn" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="high_value_threshold" type="DECIMAL(18,2)" defaultValueNumeric="5000"/>

            <!-- Suspicious login MFA -->
            <column name="enforce_on_new_device" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="enforce_on_new_location" type="BOOLEAN" defaultValueBoolean="true"/>

            <!-- Audit -->
            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="mfa_policy" baseColumnNames="policy_id"
                referencedTableName="policies" referencedColumnNames="id"
                constraintName="fk_mfa_policy_base"/>

        <createIndex tableName="mfa_policy" indexName="idx_mfa_policy_base">
            <column name="policy_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
