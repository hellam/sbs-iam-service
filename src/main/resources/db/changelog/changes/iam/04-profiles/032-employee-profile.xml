<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ============================================================= -->
    <!-- EMPLOYEE PROFILE                                              -->
    <!-- Staff / backoffice profile (HR + operational info)            -->
    <!-- Access is controlled via roles, not access_level              -->
    <!-- ============================================================= -->

    <changeSet id="pg-iam-032-employee-profile" author="hellamimbosa">

        <comment>
            EMPLOYEE_PROFILE stores HR/operational information
            for staff who access the bank's backoffice systems.

            It does NOT contain passwords, PINs, or MFA secrets.
            Those are stored in employee_auth.

            Access control is done via RBAC (roles and permissions),
            not via a crude access_level flag, so access_level
            has been intentionally removed.
        </comment>

        <createTable tableName="employee_profile">

            <!-- PK = FK to IAM_USER (user_category = EMPLOYEE) -->
            <column name="iam_user_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_employee_profile"/>
            </column>

            <!-- Staff number, used also as a common login identifier for BO -->
            <column name="staff_no" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- HR / structural metadata -->
            <column name="job_title" type="VARCHAR(255)"/>
            <column name="department" type="VARCHAR(255)"/>

            <!-- ACTIVE, SUSPENDED, TERMINATED, ON_LEAVE -->
            <column name="employment_status" type="VARCHAR(50)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>

            <!-- Branch assignment for branch-scoped operations -->
            <column name="branch_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Audit -->
            <column name="created_at" type="TIMESTAMPTZ" defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <!-- FK to IAM_USER -->
        <addForeignKeyConstraint
                baseTableName="employee_profile" baseColumnNames="iam_user_id"
                referencedTableName="iam_user" referencedColumnNames="id"
                constraintName="fk_employee_profile_iam_user"/>

        <!-- FK to branches (from your existing branches table) -->
        <addForeignKeyConstraint
                baseTableName="employee_profile" baseColumnNames="branch_id"
                referencedTableName="branches" referencedColumnNames="id"
                constraintName="fk_employee_profile_branch"/>

        <createIndex tableName="employee_profile" indexName="idx_employee_profile_branch">
            <column name="branch_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
