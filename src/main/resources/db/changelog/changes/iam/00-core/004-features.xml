<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="
                     http://www.liquibase.org/xml/ns/dbchangelog
                     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="pg-core-004-features" author="hellamimbosa">

        <createTable tableName="features">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <!-- e.g. TRANSFER, BILL_PAY, AIRTIME, RTGS, BULK_PAYMENTS, FX_TRANSFER -->
            <column name="code" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- e.g. INTERNET_BANKING, MOBILE_BANKING, API -->
            <column name="channel" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="category" type="VARCHAR(50)"/>

            <!-- ALLOW / BLOCK -->
            <column name="enabled" type="BOOLEAN" defaultValue="true">
                <constraints nullable="false"/>
            </column>

            <!-- Distinguish transaction features from informational/non-transactional features -->
            <column name="is_transaction" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMPTZ" defaultValueDate="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="features" indexName="idx_features_txn_enabled">
            <column name="is_transaction"/>
            <column name="enabled"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
