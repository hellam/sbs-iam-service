<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 065 - ORGANIZATION USER → ORG ROLES -->

    <changeSet id="pg-rbac-065-org-user-role" author="hellamimbosa">

        <createTable tableName="org_user_role">

            <column name="organization_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="org_role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="assigned_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <addPrimaryKey tableName="org_user_role"
                       columnNames="organization_user_id,org_role_id"
                       constraintName="pk_org_user_role"/>

        <addForeignKeyConstraint
                baseTableName="org_user_role"
                baseColumnNames="organization_user_id"
                referencedTableName="organization_user"
                referencedColumnNames="id"
                constraintName="fk_org_user_role_user"/>

        <addForeignKeyConstraint
                baseTableName="org_user_role"
                baseColumnNames="org_role_id"
                referencedTableName="org_role"
                referencedColumnNames="id"
                constraintName="fk_org_user_role_role"/>

        <createIndex tableName="org_user_role"
                     indexName="idx_org_user_role_user">
            <column name="organization_user_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
