<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 063 - ORG ROLES (PER ORGANIZATION) -->

    <changeSet id="pg-rbac-063-org-role" author="hellamimbosa">

        <createTable tableName="org_role">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_org_role"/>
            </column>

            <!-- party.id representing organization -->
            <column name="organization_party_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="TEXT"/>

            <!-- Canonical workflow task role -->
            <column name="task_role" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="is_default" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>

            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="org_role"
                baseColumnNames="organization_party_id"
                referencedTableName="party"
                referencedColumnNames="id"
                constraintName="fk_org_role_org"/>

        <createIndex tableName="org_role"
                     indexName="idx_org_role_org">
            <column name="organization_party_id"/>
        </createIndex>

        <createIndex tableName="org_role"
                     indexName="idx_org_role_task_role">
            <column name="task_role"/>
        </createIndex>

        <addUniqueConstraint
                tableName="org_role"
                constraintName="ux_org_role_org_name"
                columnNames="organization_party_id,name"/>

        <!-- Enables scoped FK from organization_user(org_role_id, organization_party_id) -->
        <addUniqueConstraint
                tableName="org_role"
                constraintName="ux_org_role_id_org_party"
                columnNames="id,organization_party_id"/>

        <sql>
            ALTER TABLE org_role
            ADD CONSTRAINT ck_org_role_task_role
            CHECK (task_role IN ('MAKER', 'CHECKER', 'APPROVER'));
        </sql>

    </changeSet>

</databaseChangeLog>
