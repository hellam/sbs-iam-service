<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 112 - TRUSTED DEVICES -->

    <changeSet id="pg-iam-112-trusted-devices" author="hellamimbosa">

        <createTable tableName="trusted_devices">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_trusted_devices"/>
            </column>

            <column name="iam_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Internal device fingerprint -->
            <column name="device_id" type="VARCHAR(255)" remarks="Unique device identifier">
                <constraints nullable="false"/>
            </column>

            <column name="device_name" type="VARCHAR(255)"/>
            <column name="platform" type="VARCHAR(50)" remarks="ANDROID, IOS, WINDOWS etc"/> <!-- ANDROID, IOS, WEB, etc -->

            <column name="first_seen_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="last_seen_at" type="TIMESTAMPTZ"/>
            <column name="last_ip_address" type="VARCHAR(50)"/>

            <column name="is_trusted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="mfa_verified_at" type="TIMESTAMPTZ"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="trusted_devices" baseColumnNames="iam_user_id"
                referencedTableName="iam_user" referencedColumnNames="id"
                constraintName="fk_trusted_devices_user"/>

        <createIndex tableName="trusted_devices" indexName="idx_trusted_devices_user">
            <column name="iam_user_id"/>
        </createIndex>

        <createIndex tableName="trusted_devices" indexName="idx_trusted_devices_device">
            <column name="device_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
