<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ============================================================= -->
    <!-- IAM AUDIT LOG                                                 -->
    <!-- Records all security-relevant actions                         -->
    <!-- Consider partitioning by date or archiving old logs for performance -->
    <!-- ============================================================= -->

    <changeSet id="pg-iam-060-audit-log" author="hellamimbosa">

        <comment>
            IAM_AUDIT_LOG records all login attempts, password/PIN changes,
            MFA actions, role updates, approvals, and identity events.
            Used for compliance (CBK, SOC2, PCI-DSS).
        </comment>

        <createTable tableName="iam_audit_log">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_iam_audit_log"/>
            </column>

            <!-- IAM user performing action (nullable for failed attempts without match) -->
            <column name="iam_user_id" type="BIGINT"/>

            <!-- CUSTOMER, CORPORATE, EMPLOYEE, SYSTEM -->
            <column name="user_category" type="VARCHAR(50)"/>

            <!-- Event type -->
            <column name="event_type" type="VARCHAR(100)">
                <!-- e.g. LOGIN_SUCCESS, LOGIN_FAILED, PASSWORD_CHANGED -->
                <constraints nullable="false"/>
            </column>

            <!-- Channel: IB, MB, BACKOFFICE -->
            <column name="channel" type="VARCHAR(50)"/>

            <!-- Context: IP, device ID, user-agent -->
            <column name="ip_address" type="VARCHAR(50)"/>
            <column name="device_id" type="VARCHAR(255)"/>
            <column name="user_agent" type="TEXT"/>

            <!-- Additional JSON metadata -->
            <column name="metadata" type="JSONB"/>
            
            <!-- Affected entity (e.g. target user ID for role changes) -->
            <column name="entity_id" type="BIGINT"/>
            <column name="entity_type" type="VARCHAR(100)"/>

            <!-- Timestamp -->
            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="iam_audit_log" baseColumnNames="iam_user_id"
                referencedTableName="iam_user" referencedColumnNames="id"
                constraintName="fk_audit_user"/>

        <createIndex tableName="iam_audit_log" indexName="idx_audit_user">
            <column name="iam_user_id"/>
        </createIndex>

        <createIndex tableName="iam_audit_log" indexName="idx_audit_event_type">
            <column name="event_type"/>
        </createIndex>
        
        <createIndex tableName="iam_audit_log" indexName="idx_audit_created_at">
            <column name="created_at"/>
        </createIndex>

        <createIndex tableName="iam_audit_log" indexName="idx_audit_category">
            <column name="user_category"/>
        </createIndex>
        <createIndex tableName="iam_audit_log" indexName="idx_audit_channel">
            <column name="channel"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
