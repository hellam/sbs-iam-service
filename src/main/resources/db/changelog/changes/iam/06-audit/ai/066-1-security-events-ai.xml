<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 133 - SECURITY EVENTS: AI & HANDLING METADATA -->

    <changeSet id="pg-iam-066-1-security-events-ai" author="hellamimbosa">

        <!-- Risk score evaluated at event time -->
        <addColumn tableName="security_events">
            <column name="risk_score" type="SMALLINT" defaultValueNumeric="0"/>
        </addColumn>

        <!-- ML / rule engine version -->
        <addColumn tableName="security_events">
            <column name="risk_model_version" type="VARCHAR(50)"/>
        </addColumn>

        <!-- Workflow state for SOC / fraud team -->
        <addColumn tableName="security_events">
            <!-- NEW, IN_REVIEW, CLOSED, DISMISSED -->
            <column name="status" type="VARCHAR(50)" defaultValue="NEW"/>
        </addColumn>

        <addColumn tableName="security_events">
            <!-- IAM user (staff) who handled it, optional -->
            <column name="handled_by_iam_user_id" type="BIGINT"/>
        </addColumn>

        <addColumn tableName="security_events">
            <column name="handled_at" type="TIMESTAMPTZ"/>
        </addColumn>

        <addColumn tableName="security_events">
            <column name="handling_notes" type="TEXT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="security_events" baseColumnNames="handled_by_iam_user_id"
                referencedTableName="iam_user" referencedColumnNames="id"
                constraintName="fk_security_events_handled_by"
                deferrable="true" initiallyDeferred="true"/>

        <createIndex tableName="security_events" indexName="idx_security_events_risk">
            <column name="risk_score"/>
        </createIndex>

        <createIndex tableName="security_events" indexName="idx_security_events_status">
            <column name="status"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
