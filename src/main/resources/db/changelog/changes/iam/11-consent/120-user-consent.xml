<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 120 - USER CONSENT -->

    <changeSet id="pg-iam-120-user-consent" author="hellamimbosa">

        <createTable tableName="user_consent">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_user_consent"/>
            </column>

            <column name="iam_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- TOS, PRIVACY, MARKETING, etc -->
            <column name="consent_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <!-- Version of T&C / policy document -->
            <column name="version" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="accepted_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

            <column name="device_id" type="VARCHAR(255)"/>
            <column name="ip_address" type="VARCHAR(50)"/>
            <column name="user_agent" type="TEXT"/>
            <column name="channel" type="VARCHAR(50)"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="user_consent" baseColumnNames="iam_user_id"
                referencedTableName="iam_user" referencedColumnNames="id"
                constraintName="fk_user_consent_user"/>

        <createIndex tableName="user_consent" indexName="idx_user_consent_user">
            <column name="iam_user_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
