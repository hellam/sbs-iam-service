<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="pg-iam-012-user-contacts" author="hellamimbosa">

        <comment>
            Creates a table to hold user contacts (email, phone) that can be linked to different profiles.
        </comment>

        <createTable tableName="iam_user_contact">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_iam_user_contact"/>
            </column>
            <column name="iam_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="contact_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="contact_value" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="is_primary" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueDate="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="iam_user_contact" baseColumnNames="iam_user_id"
                referencedTableName="iam_user" referencedColumnNames="id"
                constraintName="fk_iam_user_contact_iam_user"/>

        <createIndex tableName="iam_user_contact" indexName="idx_iam_user_contact_user_id">
            <column name="iam_user_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>

