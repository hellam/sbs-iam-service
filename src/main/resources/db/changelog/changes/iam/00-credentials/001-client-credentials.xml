<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="pg-iam-001-client-credentials" author="hellamimbosa">

        <createTable tableName="client_credentials">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_client_credentials"/>
            </column>

            <!-- Logical ID (service name) -->
            <column name="client_id" type="VARCHAR(150)">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- Hashed secret -->
            <column name="client_secret_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- Certificate fingerprint for mTLS binding -->
            <column name="certificate_fingerprint" type="VARCHAR(128)"/>

            <!-- e.g. iam.read, iam.admin, tx.init -->
            <column name="scopes" type="TEXT"/>

            <!-- Limit which services can call from which networks -->
            <column name="allowed_ip_ranges" type="TEXT"/>

            <!-- If true, mTLS is mandatory for this client -->
            <column name="requires_mtls" type="BOOLEAN" defaultValueBoolean="true"/>

            <!-- if token is JWT or opaque -->
            <column name="token_type" type="VARCHAR(20)" defaultValue="jwt"/>

            <!-- Metadata -->
            <column name="description" type="TEXT"/>

            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>

            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

            <column name="updated_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

            <column name="last_used_at" type="TIMESTAMPTZ"/>

        </createTable>

        <createIndex tableName="client_credentials"
                     indexName="idx_client_credentials_client_id">
            <column name="client_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
