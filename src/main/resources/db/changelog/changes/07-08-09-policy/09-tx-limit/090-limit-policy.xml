<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="
                     http://www.liquibase.org/xml/ns/dbchangelog
                     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="pg-policy-100-limit-policy" author="hellamimbosa">

        <createTable tableName="limit_policy">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="transaction_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="single_transaction_limit" type="DECIMAL(18,2)"/>
            <column name="daily_limit" type="DECIMAL(18,2)"/>
            <column name="monthly_limit" type="DECIMAL(18,2)"/>

            <!-- Optional frequency limit (number of transactions) -->
            <column name="daily_txn_count_limit" type="INTEGER"/>
            <column name="monthly_txn_count_limit" type="INTEGER"/>

            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="limit_policy" baseColumnNames="transaction_type_id"
                referencedTableName="transaction_type" referencedColumnNames="id"
                constraintName="fk_limit_policy_txn_type"/>

    </changeSet>

</databaseChangeLog>
