<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ============================================================= -->
    <!-- PASSWORD POLICY                                               -->
    <!-- Based on NIST SP 800-63B, PCI DSS 4.0, ISO27001              -->
    <!-- ============================================================= -->

    <changeSet id="pg-iam-071-password-policy" author="hellamimbosa">

        <createTable tableName="password_policy">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_password_policy"/>
            </column>

            <column name="policy_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- Length rules -->
            <column name="min_length" type="SMALLINT" defaultValueNumeric="12"/>
            <column name="max_length" type="SMALLINT" defaultValueNumeric="128"/>

            <!-- Complexity -->
            <column name="require_uppercase" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="require_lowercase" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="require_number" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="require_symbol" type="BOOLEAN" defaultValueBoolean="false"/>

            <!-- Optional dictionary / breached password checks -->
            <column name="block_common_passwords" type="BOOLEAN" defaultValueBoolean="true"/>

            <!-- Reuse policy -->
            <column name="password_history_count" type="SMALLINT" defaultValueNumeric="5"/>

            <!-- Expiry rules (NIST recommends disabled, PCI may require it) -->
            <column name="expiration_enabled" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="expiration_days" type="SMALLINT" defaultValueNumeric="90"/>

            <!-- Lockout rules -->
            <column name="max_failed_attempts" type="SMALLINT" defaultValueNumeric="5"/>
            <column name="lockout_minutes" type="SMALLINT" defaultValueNumeric="30"/>

            <!-- Factory password reset option -->
            <column name="require_factory_reset" type="BOOLEAN" defaultValueBoolean="false"/>

            <!-- Hashing -->
            <column name="hash_algorithm" type="VARCHAR(50)" defaultValue="bcrypt"/>
            <column name="hash_cost" type="SMALLINT" defaultValueNumeric="12"/>

            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="password_policy" baseColumnNames="policy_id"
                referencedTableName="policies" referencedColumnNames="id"
                constraintName="fk_password_policy_policy"/>

        <createIndex tableName="password_policy" indexName="idx_password_policy_base">
            <column name="policy_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
