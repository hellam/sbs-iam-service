<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="
                     http://www.liquibase.org/xml/ns/dbchangelog
                     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="pg-policy-082-feature-assignment" author="hellamimbosa">

        <createTable tableName="feature_policy_assignment">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="feature_policy_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- GLOBAL / ORG / USER -->
            <column name="scope" type="feature_policy_scope_enum" defaultValue="GLOBAL"/>

            <!-- Nullable depending on scope -->
            <column name="organization_id" type="BIGINT"/>
            <column name="iam_user_id" type="BIGINT"/>

            <column name="created_at" type="TIMESTAMPTZ"
                    defaultValueDate="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="feature_policy_assignment" baseColumnNames="feature_policy_id"
                                 referencedTableName="feature_policy" referencedColumnNames="id"
                                 constraintName="fk_feature_policy_assignment"/>

        <addForeignKeyConstraint baseTableName="feature_policy_assignment" baseColumnNames="organization_id"
                                 referencedTableName="party" referencedColumnNames="id"
                                 constraintName="fk_feature_assignment_org"/>

        <addForeignKeyConstraint baseTableName="feature_policy_assignment" baseColumnNames="iam_user_id"
                                 referencedTableName="iam_user" referencedColumnNames="id"
                                 constraintName="fk_feature_assignment_user"/>

    </changeSet>

</databaseChangeLog>
