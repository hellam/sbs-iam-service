<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ============================================================= -->
    <!-- ORGANIZATION TABLE                                            -->
    <!-- Represents SME & Corporate entities                           -->
    <!-- Organizations NEVER authenticate                              -->
    <!-- ORGANIZATION_USER links IAM_USER to this table                -->
    <!-- ============================================================= -->

    <changeSet id="pg-iam-012-organization" author="hellamimbosa">

        <comment>
            ORGANIZATION table stores business entity details for:
            - SMEs,
            - Large corporate customers,
            - Merchants or agents (future),
            - Any legal entity that can have accounts.

            Only PERSON → IAM_USER can log in.
            Organization exists only as a legal + operational container.
        </comment>

        <createTable tableName="organization">

            <!-- PK is also FK to PARTY -->
            <column name="party_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_organization"/>
            </column>

            <!-- Legal entity information -->
            <column name="legal_name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="display_name" type="VARCHAR(255)"/>
            <column name="registration_no" type="VARCHAR(100)">
                <constraints unique="true"/>
            </column>

            <!-- SME or CORPORATE -->
            <column name="customer_segment" type="org_segment_enum">
                <constraints nullable="false"/>
            </column>

            <!-- SME subsets -->
            <column name="sme_mode" type="sme_mode_enum"/>

            <!-- Country & address -->
            <column name="country_code" type="VARCHAR(3)"/>
            <column name="address" type="VARCHAR(255)"/>
            <column name="city" type="VARCHAR(100)"/>

            <!-- Company contact details -->
            <column name="company_phone" type="VARCHAR(20)"/>
            <column name="company_email" type="VARCHAR(255)"/>

            <!--  Contact person for the organization -->
            <column name="contact_person_name" type="VARCHAR(200)"/>
            <column name="contact_person_email" type="VARCHAR(255)"/>
            <column name="contact_person_phone" type="VARCHAR(20)"/>

            <!-- Audit fields -->
            <column name="created_at" type="TIMESTAMPTZ" defaultValueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueDate="CURRENT_TIMESTAMP"/>

        </createTable>

        <!-- FK to PARTY -->
        <addForeignKeyConstraint
                baseTableName="organization" baseColumnNames="party_id"
                referencedTableName="party" referencedColumnNames="id"
                constraintName="fk_org_party"/>

        <!-- FK to COUNTRIES -->
        <addForeignKeyConstraint
                baseTableName="organization" baseColumnNames="country_code"
                referencedTableName="countries" referencedColumnNames="country_code"
                constraintName="fk_org_country"/>

        <createIndex tableName="organization" indexName="idx_org_segment">
            <column name="customer_segment"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
