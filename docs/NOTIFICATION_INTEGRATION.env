# Notification Service Integration - IAM Service

# ==============================================
# Notification Client Configuration
# ==============================================

# Notification Service URL (where the notification service is running)
NOTIFICATION_SERVICE_URL=http://localhost:9003

# Kafka Topic for async notifications
NOTIFICATION_KAFKA_TOPIC=notifications.bulk.v1

# Timeout for notification requests (in seconds)
NOTIFICATION_TIMEOUT=10

# ==============================================
# How to Use Notification Client in IAM Service
# ==============================================

# The NotificationService is autowired and ready to use:
#
# @Autowired
# private NotificationService notificationService;
#
# // Send OTP via SMS
# notificationService.sendOtpViaSms("+252770612971", "123456");
#
# // Send OTP via WhatsApp with button
# notificationService.sendOtpViaWhatsApp("+252770612971", "123456");
#
# // Send OTP via Email
# notificationService.sendOtpViaEmail("user@example.com", "123456");
#
# // Send welcome message
# notificationService.sendWelcomeMessage(
#     ChannelType.SMS,
#     "+252770612971",
#     "John Doe",
#     Map.of("accountNumber", "1234567890")
# );

# ==============================================
# Available Channels
# ==============================================

# - SMS: For text messages (via Hormuud or other providers)
# - EMAIL: For email notifications
# - WHATSAPP: For WhatsApp messages (with template support)

# ==============================================
# Priority Levels
# ==============================================

# - CRITICAL: Uses SYNC mode (immediate, waits for result)
#   Examples: OTP, password reset, account verification
#
# - HIGH: Uses ASYNC mode but prioritized
#   Examples: Login alerts, security notifications
#
# - NORMAL: Uses ASYNC mode (queued to Kafka)
#   Examples: Welcome messages, promotional content

# ==============================================
# Template Codes (Examples)
# ==============================================

# These templates should be created in the Notification Service:
# - otp_verification: For OTP messages
# - welcome_message: For welcoming new users
# - password_reset: For password reset links
# - login_alert: For login notifications
# - account_verification: For account verification links

# ==============================================
# Example Usage in Authentication Flow
# ==============================================

# 1. User requests login with phone number
# 2. Generate OTP
# 3. Send OTP:
#    notificationService.sendOtpViaSms(phoneNumber, otp);
# 4. User enters OTP
# 5. Verify and complete login

# ==============================================
# Example Usage in Registration Flow
# ==============================================

# 1. User registers with email
# 2. Generate verification token
# 3. Send verification email:
#    notificationService.sendAccountVerificationLink(
#        email, userName, verificationLink
#    );
# 4. User clicks link
# 5. Account verified

# ==============================================
# Error Handling
# ==============================================

# The notification client throws NotificationClientException on failure.
# Always wrap notification calls in try-catch:
#
# try {
#     SendNotificationResponse response =
#         notificationService.sendOtpViaSms(phone, otp);
#
#     if ("SENT".equals(response.getStatus())) {
#         log.info("OTP sent successfully");
#     }
# } catch (NotificationClientException e) {
#     log.error("Failed to send OTP", e);
#     // Handle error (retry, use fallback, etc.)
# }

# ==============================================
# Testing
# ==============================================

# 1. Start Notification Service:
#    cd services/sbs-notification-service-v1
#    mvn spring-boot:run
#
# 2. Start IAM Service:
#    cd services/sbs-iam-service
#    mvn spring-boot:run
#
# 3. Test sending notification:
#    curl -X POST http://localhost:8080/api/v1/oauth/test/send-otp \
#      -H "Content-Type: application/json" \
#      -d '{"phoneNumber": "+252770612971", "otp": "123456"}'

